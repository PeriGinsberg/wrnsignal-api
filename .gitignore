.next
*.tsbuildinfo
next-env.d.ts

# Dependencies
node_modules/

# Environment files
.env.local
.env*.local

# Vercel
.vercel

# Mobile
signal-mobile/

# Test outputs
docs/test_cases/out/
tests/**/results/
outputs/

# Migration / inference results (may contain anonymized-but-recognizable prod data)
scripts/migrate-candidate-targeting/results/

# Operational pg_dump / pg_restore artifacts — ad-hoc, not source of truth
prod_schema.sql
prod_public_schema.sql
prod-schema-snapshot.sql
restore_log.txt

# Local tooling / scratch
.claude/

# OS
.DS_Store
Thumbs.db

# Sensitive — never commit
Apple/
**/AuthKey_*.p8
*.pem
# Design reference only, never commit and never deploy. Build plan, merge spec
# and the screen mockups for the light-theme redesign. Local-only by intent:
# Vercel builds from this repo, and these are ~5 MB of PNGs plus specs that are
# not code. Was ignored via an uncommitted .gitignore edit, which went away.
Redesign0826/

# Real client resumes — used as local test fixtures, never commit
Resumes/
# Real client contact lists — local import test fixtures, never commit
network-import-fixtures/
# Python bytecode from the regression tooling
__pycache__/

# Timestamped run logs from seed / copy scripts. Generalises the
# scripts/migrate-candidate-targeting/results/ rule above; the tests/ side is
# already covered by tests/**/results/.
scripts/**/results/

# Ad-hoc UI captures. Referenced by nothing in the repo.
screen shots/

# One-off scaffold archive
signal-jobfit-cc-scaffold.zip

# JobFit diagnosis cases pulled from prod: real resumes + contact details.
evals/jobfit/cases/

# Per-client interview workbook content: real names, employers, interviewers
# and interview dates, same class of data as evals/jobfit/cases above. The
# workbooks are created from these files with scripts/create-workbook.ts and
# then live in the database, so the repo is not their home.
# WORKBOOK_V1_SPEC.md has been moved out to docs/workbooks/ and IS tracked.
# docs/workbooks/design-reference/ is deliberately NOT tracked yet: the mocks
# carry a real client's name and employer in the breadcrumb.
docs/workbooks-v1/
docs/workbooks-v1.zip
